# Production DATABASE host settings (deploy/docker-compose.db.yml).
# Copy to deploy/.env.db and fill in every value.

# Private address of this host that the app host can reach (never a public IP).
MONGO_BIND_IP=10.0.0.5
MONGO_PORT=27017

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME

# Least-privilege user the app connects with (must match MONGODB_URI on the app host).
APP_DB_NAME=pixel_directory
APP_DB_USER=pixel_app
APP_DB_PASSWORD=CHANGE_ME
