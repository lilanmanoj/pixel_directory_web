# Production APP host settings (deploy/docker-compose.prod.yml).
# Copy to deploy/.env and fill in every value.

# Public domain; its DNS A/AAAA record must point at this host (Caddy gets TLS automatically).
DOMAIN=directory.example.com
ACME_EMAIL=ops@example.com

# MongoDB on the separate DB host (or Atlas). URL-encode special characters in the password.
MONGODB_URI=mongodb://pixel_app:CHANGE_ME@10.0.0.5:27017/pixel_directory?authSource=pixel_directory

# Long random string, e.g.: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# First administrator, created on first start if no admin exists. Change the password after signing in.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

CURRENCY=USD
MAX_UPLOAD_MB=5
SEED_DEMO_DATA=false
# Only "mock" is implemented — see README "Payments".
PAYMENT_PROVIDER=mock
