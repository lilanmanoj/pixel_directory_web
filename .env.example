# Optional overrides for the LOCAL stack (docker-compose.yml).
# Copy to .env and edit; every value has a default.

WEB_PORT=3000
API_PORT=4000
# Only used if you enable docker-compose.override.yml (MongoDB on the host)
MONGO_PORT=27018

ADMIN_EMAIL=admin@pixel.local
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true
JWT_SECRET=local-dev-secret-change-me
CURRENCY=USD
